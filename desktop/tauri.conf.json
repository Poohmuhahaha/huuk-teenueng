{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Huuk",
  "version": "1.0.0",
  "identifier": "com.teeneung.huuk",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../app run dev:desktop",
    "beforeBuildCommand": "npm --prefix ../app run build:desktop",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Huuk",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Plan, publish and measure content in one workspace.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/content-planner-server"]
  }
}
