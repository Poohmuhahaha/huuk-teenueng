{
  "$description": "Teenueng design system — W3C Design Tokens (DTCG) format. Import via Tokens Studio (Figma) or any DTCG-aware tool.",
  "color": {
    "ink":        { "$type": "color", "$value": "#000000" },
    "paper":      { "$type": "color", "$value": "#ffffff" },
    "paper-frosted": { "$type": "color", "$value": "#ffffff", "$extensions": { "alpha": 0.88 } },
    "muted":      { "$type": "color", "$value": "#6b6b6b" },
    "faint":      { "$type": "color", "$value": "#a3a3a3" },
    "line":       { "$type": "color", "$value": "#e4e4e4" },
    "ink-body":   { "$type": "color", "$value": "#1a1a1a" },
    "sketch-stroke": { "$type": "color", "$value": "#e3e3e3" },
    "sketch-fill":   { "$type": "color", "$value": "#f1f1f1" },
    "sketch-moon":   { "$type": "color", "$value": "#eaeaea" },
    "floor":         { "$type": "color", "$value": "#cfcfcf" }
  },
  "fontFamily": {
    "main":      { "$type": "fontFamily", "$value": ["Tinos", "Times New Roman", "Times", "Georgia", "serif"] },
    "secondary": { "$type": "fontFamily", "$value": ["Inter Variable", "Inter", "ui-sans-serif"] }
  },
  "fontWeight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium":  { "$type": "fontWeight", "$value": 500 },
    "semibold":{ "$type": "fontWeight", "$value": 600 },
    "bold":    { "$type": "fontWeight", "$value": 700 }
  },
  "fontSize": {
    "display-1": { "$type": "fontSize", "$value": "92px" },
    "display-2": { "$type": "fontSize", "$value": "80px" },
    "heading-1": { "$type": "fontSize", "$value": "44px" },
    "heading-2": { "$type": "fontSize", "$value": "36px" },
    "heading-3": { "$type": "fontSize", "$value": "21px" },
    "title":     { "$type": "fontSize", "$value": "28px" },
    "row-title": { "$type": "fontSize", "$value": "30px" },
    "wordmark":  { "$type": "fontSize", "$value": "18px" },
    "lede":      { "$type": "fontSize", "$value": "20px" },
    "body-md":   { "$type": "fontSize", "$value": "17px" },
    "body-sm":   { "$type": "fontSize", "$value": "16px" },
    "button":    { "$type": "fontSize", "$value": "15px" },
    "button-sm": { "$type": "fontSize", "$value": "13px" },
    "caption":   { "$type": "fontSize", "$value": "14px" },
    "eyebrow":   { "$type": "fontSize", "$value": "12px" },
    "label":     { "$type": "fontSize", "$value": "12px" },
    "tag":       { "$type": "fontSize", "$value": "11px" }
  },
  "lineHeight": {
    "display":   { "$type": "lineHeight", "$value": 1.02 },
    "heading-2": { "$type": "lineHeight", "$value": 1.04 },
    "body":      { "$type": "lineHeight", "$value": 1.55 },
    "label":     { "$type": "lineHeight", "$value": 1.7 }
  },
  "letterSpacing": {
    "display-1": { "$type": "dimension", "$value": "-0.02em" },
    "display-2": { "$type": "dimension", "$value": "-0.02em" },
    "heading-1": { "$type": "dimension", "$value": "-0.015em" },
    "heading-2": { "$type": "dimension", "$value": "-0.015em" },
    "title":     { "$type": "dimension", "$value": "-0.01em" },
    "body":      { "$type": "dimension", "$value": "-0.011em" },
    "eyebrow":   { "$type": "dimension", "$value": "0.22em" },
    "label":     { "$type": "dimension", "$value": "0.08em" },
    "tag":       { "$type": "dimension", "$value": "0.08em" }
  },
  "spacing": {
    "base": { "$type": "dimension", "$value": "4px" },
    "xxs":  { "$type": "dimension", "$value": "6px" },
    "xs":   { "$type": "dimension", "$value": "12px" },
    "sm":   { "$type": "dimension", "$value": "16px" },
    "md":   { "$type": "dimension", "$value": "26px" },
    "lg":   { "$type": "dimension", "$value": "34px" },
    "xl":   { "$type": "dimension", "$value": "48px" },
    "xxl":  { "$type": "dimension", "$value": "76px" }
  },
  "borderRadius": {
    "none":   { "$type": "dimension", "$value": "0px" },
    "sketch": { "$type": "dimension", "$value": "4px" }
  },
  "shadow": {
    "hard-lift": {
      "$type": "shadow",
      "$value": { "color": "#000000", "offsetX": "6px", "offsetY": "6px", "blur": "0px", "spread": "0px" }
    }
  },
  "duration": {
    "quick":  { "$type": "duration", "$value": "200ms" },
    "reveal": { "$type": "duration", "$value": "600ms" },
    "hero":   { "$type": "duration", "$value": "700ms" },
    "hop":    { "$type": "duration", "$value": "900ms" }
  },
  "cubicBezier": {
    "ease":       { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1] },
    "ease-quick": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] }
  }
}
