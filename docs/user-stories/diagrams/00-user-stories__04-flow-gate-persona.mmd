%% User Flow 01 — Global gate & persona routing (boot -> session -> auth -> workspace -> role)
flowchart TD
  Mount(["เปิดแอป — mount App.vue"]) --> Restore["restore(): อ่าน cp.token"]
  Restore --> HasTok{"มี token?"}
  HasTok -->|"no"| Clear["clearSession()"]
  HasTok -->|"yes"| Me["GET /api/auth/me (Bearer)"]
  Me --> Valid{"session ยัง valid?"}
  Valid -->|"no"| Clear
  Valid -->|"yes"| Start["startSession(token, user)"]
  Clear --> Ready
  Start --> Ready{"ready = restored และ setup พร้อม?"}
  Ready -->|"no"| Loader["boot loader"]
  Ready -->|"yes"| Public{"route เป็น public?"}
  Public -->|"yes"| PubPages["Login / Register / Plans / Read"]
  Public -->|"no"| AuthReq{"authRequired และยังไม่ล็อกอิน?"}
  AuthReq -->|"yes"| Login["/login — กรอกอีเมล + รหัสผ่าน"]
  AuthReq -->|"no"| HasWs{"มี workspace?"}
  Login --> RL{"ผิดเกิน 10 ครั้ง ต่อ 15 นาที?"}
  RL -->|"yes"| E429["429 — ลองใหม่ใน N วินาที"]
  RL -->|"no"| Cred{"email + รหัสถูกต้อง?"}
  Cred -->|"no"| E401["401 — ข้อความกลาง ๆ"]
  Cred -->|"yes"| Start
  PubPages --> Reg{"สมัครใหม่ และ allowRegistration?"}
  Reg -->|"no"| RLock["ปิดรับสมัคร"]
  Reg -->|"yes"| RVal{"ชื่อ หรือ อีเมลซ้ำ?"}
  RVal -->|"yes"| E409["409 conflict"]
  RVal -->|"no"| RStart["Argon2id + open session ไป /plans"]
  RStart --> HasWs
  HasWs -->|"ยังไม่มี (owner)"| WsSetup["/welcome — สร้าง workspace แรก"]
  HasWs -->|"มีแล้ว"| RoleGate{"role"}
  WsSetup --> RoleGate
  RoleGate -->|"Client"| StudioDeck["deck เหลือ Content Studio"]
  RoleGate -->|"Owner / Editor / Viewer"| ShellDeck["AppShell + ScreensDeck — การ์ดตามสิทธิ์ can()"]
