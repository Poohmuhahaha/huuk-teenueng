%% User Flow 03 — Core content lifecycle (idea -> planner -> studio -> publish -> public)
flowchart TD
  Idea["/ideas — คลังไอเดีย"] -->|"promote (ideas.write)"| Post["สร้าง Post (planner, lockedBy=null)"]
  Post --> Planner["/planner — Master table (posts.write)"]
  Planner --> Add["เพิ่มแถว — POST /api/posts + validate_post"]
  Planner --> Row["เลือกแถว → draft local"]
  Row --> LockChk{"lockedBy เป็นคนอื่น?"}
  LockChk -->|"yes"| Block["ปิด save/delete + แสดงเจ้าของล็อก — เซฟจะได้ 409"]
  LockChk -->|"no"| Edit["แก้ฟิลด์ (whitelist EDITABLE)"]
  Edit --> Save["PATCH /api/posts/:id"]
  Save --> SV{"require_perm posts.write + validate + lock?"}
  SV -->|"400 / 403 / 409"| Err["แสดง error ตามรหัส"]
  SV -->|"ok"| Inv["invalidate posts + metrics"]
  Inv --> Derived["Calendar / Dashboard / Feed / Performance (computed จาก posts)"]
  Planner -->|"lock / unlock (posts.lock)"| Locked["ล็อกแถวกันคนอื่นทับ"]

  Derived --> Want{"ต้องเผยแพร่เป็นบทความ?"}
  Want -->|"yes"| CMS["/studio — สร้าง/แก้ content (content.write)"]
  CMS --> Auto["autosave ทุก 1.5s — PATCH + version"]
  Auto --> CVer{"version ตรงกับ server?"}
  CVer -->|"no"| Conflict["409 — Reload latest หรือ Keep mine"]
  CVer -->|"yes"| Rev["push_revision + version++"]
  Rev --> Pub{"publish หรือ schedule?"}
  Pub -->|"publish (content.publish)"| Published["status=published + publishedAt"]
  Pub -->|"schedule (อนาคต)"| Scheduled["status=scheduled"]
  Scheduled --> Promote["promote_due_scheduled (lazy ตอนมี read)"]
  Promote --> Published
  Published --> PublicRead["/#/read/{slug} — public reader (escape markdown)"]
