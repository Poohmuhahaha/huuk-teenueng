%% User Flow 05 — Admin / setup & client onboarding
flowchart TD
  O["Owner"] --> Set["/settings"]
  Set --> Setup["แก้ setup + options (setup.write)"]
  Set --> Roles["role matrix (users.manage) — permission ต้องอยู่ใน KNOWN_PERMISSIONS"]
  Set --> Users["directory users (users.manage)"]
  Set --> NewAcc["สร้างบัญชีลูกค้า (users.manage)"]
  NewAcc --> Val{"role มีจริง และ email/name ไม่ซ้ำ?"}
  Val -->|"no"| E409["400 / 409"]
  Val -->|"yes"| Gen["gen cp-12hex (ถ้าไม่ส่งรหัส) + Argon2id + directory role"]
  Gen --> Once["แสดง temp password ครั้งเดียว"]
  Once --> Client["ลูกค้าล็อกอิน — role Client"]
  Client --> StudioOnly["เห็นเฉพาะ Content Studio"]
  StudioOnly --> Draft["เขียน/แก้ content (content.write)"]
  Draft --> Pub["publish/schedule (content.publish)"]
  Pub --> ReadHimself["ลูกค้าแชร์ /#/read/{slug}"]
  Roles --> Recalc["FE invalidate setup → can() คำนวณใหม่ทันที"]
  Setup --> AuthReq["authRequired เปิด = บังคับล็อกอิน (ปิด = demo)"]
