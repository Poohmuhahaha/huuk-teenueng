# Static host for the built SPA + same-origin proxy to the API container.
# (Replaces ops/nginx/nginx.conf — the stack is Caddy-only now.)
#
# Known gap vs the old nginx host: stock Caddy has no per-IP rate limiting,
# so the old `limit_req` tiers (5r/s auth, 30r/s api) are gone. If brute-force
# protection is needed, add it in the Rust backend — per-account limits there
# also stay correct behind the optional Caddy TLS front, where every request
# used to arrive from a single IP and edge limits became global.
:8080 {
	encode gzip

	# API proxy (same origin, so the browser never needs CORS).
	# The Rust API sets its own security headers — none are added here,
	# so they are not duplicated. No proxy read timeout: the API's own
	# 30s middleware fires first, as it did behind nginx (35s).
	handle /api/* {
		request_body {
			max_size 3MB
		}
		reverse_proxy api:8787
	}

	# Hashed Vite assets can be cached forever; missing files 404
	# (no SPA fallback here — a missing hash is a real error).
	handle /assets/* {
		root * /srv
		header Cache-Control "public, immutable"
		header X-Content-Type-Options nosniff
		header X-Frame-Options DENY
		header Referrer-Policy no-referrer
		header Permissions-Policy "camera=(), microphone=(), geolocation=()"
		file_server
	}

	# Everything else is the SPA shell (hash routing: every path serves
	# index.html). Never cached — it references the hashed bundles above.
	# The CSP/no-cache policy applies to fallback routes too (stricter than
	# the old nginx host, which sent them only for an exact /index.html hit;
	# every fallback response IS index.html content, so it gets the same policy).
	handle {
		root * /srv
		header Cache-Control "no-cache"
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		header X-Content-Type-Options nosniff
		header X-Frame-Options DENY
		header Referrer-Policy no-referrer
		header Permissions-Policy "camera=(), microphone=(), geolocation=()"
		try_files {path} /index.html
		file_server
	}
}
