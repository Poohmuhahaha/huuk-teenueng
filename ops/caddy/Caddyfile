# ops/caddy/Caddyfile — Canonical Single-File Production Config (Master Engineering SOP §4.2)
{$APP_DOMAIN::80, :8080} {
    encode zstd gzip

    # 1. Hardened security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self';"
        -Server
    }

    # 2. Agent / SSE Streaming endpoints (MUST precede general /api/* and disable buffering)
    handle /api/agent/stream/* {
        reverse_proxy {$API_UPSTREAM:api:8787} {
            lb_policy round_robin
            health_uri /healthz
            health_interval 2s
            health_timeout 1s
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            flush_interval -1
        }
    }

    # 3. Standard API Reverse Proxy with Active Healthcheck for Zero-Downtime Scaling
    handle /api/* {
        reverse_proxy {$API_UPSTREAM:api:8787} {
            lb_policy round_robin
            health_uri /healthz
            health_interval 2s
            health_timeout 1s
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /healthz {
        reverse_proxy {$API_UPSTREAM:api:8787}
    }

    # 4. Cache rule: static assets (Vite hashed files) -> immutable, 1 year
    @static {
        path /assets/*
    }
    header @static {
        Cache-Control "public, max-age=31536000, immutable"
    }

    # 5. Cache rule: entry HTML -> never cache
    @html {
        path /index.html /
    }
    header @html {
        Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    # 6. SPA routing fallback
    handle {
        root * {$FRONTEND_ROOT:/srv/frontend}
        try_files {path} /index.html
        file_server
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 10
        }
        format json
    }
}
