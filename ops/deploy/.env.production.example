# Huuk by teenueng — production environment for docker-compose.
# Create with `ops/scripts/deploy.sh init` (it generates the admin password and token),
# then edit the URL fields below.

# ---- bootstrap Owner (first boot only) ----
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=__ADMIN_PASSWORD__
# Break-glass token for the X-Admin-Token header (keep secret).
ADMIN_TOKEN=__ADMIN_TOKEN__

# ---- mode (production defaults) ----
AUTH_REQUIRED=true
ALLOW_REGISTRATION=false
# Set true to open self-serve signup (SaaS); new accounts get the read-only
# Viewer role until an Owner assigns one. Default is invite-only.
# DEMO_MODE is intentionally unset: demo accounts/seed stay off.

# ---- public URLs (used for OAuth callbacks + CORS) ----
# Behind the bundled proxy this is usually just your public origin.
FRONTEND_URL=http://localhost:8080
PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# ---- compose ----
# Host interface + port for the web container (ignored by the Caddy TLS front).
# 127.0.0.1 = this machine only (default); 0.0.0.0 = reachable on the LAN.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Domain for `ops/scripts/deploy.sh up --tls`, e.g. huuk.teenueng.com. Empty = HTTP-only.
SITE_ADDRESS=

# ---- logs ----
RUST_LOG=info

# ---- optional real OAuth (leave commented for mock mode) ----
# META_APP_ID=
# META_APP_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# ---- optional frontend build overrides (rarely needed) ----
# VITE_API_URL=
# VITE_USE_MOCK=
