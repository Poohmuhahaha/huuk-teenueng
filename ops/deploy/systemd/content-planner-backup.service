# Daily snapshot backup for the compose deployment (installed manually).
#
#   sudo sed "s|__REPO__|$PWD|; s|__RUN_USER__|$USER|" \
#     ops/deploy/systemd/content-planner-backup.{service,timer} >/etc/systemd/system/  (one at a time)
#   sudo systemctl daemon-reload && sudo systemctl enable --now content-planner-backup.timer
[Unit]
Description=Content Planner snapshot backup (deploy.sh backup)

[Service]
Type=oneshot
User=__RUN_USER__
SupplementaryGroups=docker
WorkingDirectory=__REPO__
ExecStart=__REPO__/deploy.sh backup
