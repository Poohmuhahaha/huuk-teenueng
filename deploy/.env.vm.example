# Huuk on a 24/7 VM — Docker environment.
# Copy to deploy/.env.vm (gitignored) and replace every placeholder.
#
#   cp deploy/.env.vm.example deploy/.env.vm
#   chmod 600 deploy/.env.vm
#
# The first boot creates the Owner account from ADMIN_EMAIL / ADMIN_PASSWORD.
# Keep ADMIN_TOKEN safe: it also derives the key that encrypts OAuth tokens.

# ---- bootstrap Owner (first boot only) ----
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-123
ADMIN_TOKEN=replace-with-a-random-token-at-least-32-chars

# ---- production mode ----
AUTH_REQUIRED=true
ALLOW_REGISTRATION=false
DEMO_MODE=0

# ---- public origin ----
PUBLIC_URL=https://app.example.com
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
COOKIE_SECURE=1

# ---- HTTPS directly on the VM (Caddy + Let's Encrypt) ----
# Point an A record for APP_DOMAIN at the VM's public IP first.
# Start with --profile caddy (no Cloudflare account required).
APP_DOMAIN=app.example.com
ACME_EMAIL=you@example.com

# ---- PostgreSQL container ----
# The app connects to postgres:5432 inside the compose network. Port 5432 is
# published on 127.0.0.1 only; use an SSH tunnel for DBeaver/pgAdmin/psql.
POSTGRES_USER=huuk
POSTGRES_DB=huuk
POSTGRES_PASSWORD=replace-with-a-long-random-password
# 0 = run migrations explicitly (recommended); 1 = auto-migrate on app boot.
AUTO_MIGRATE=0

# ---- image tag (change per deploy for easy rollback) ----
HUUK_IMAGE_TAG=local

# ---- logs ----
RUST_LOG=info

# ---- optional Cloudflare Tunnel (when using --profile tunnel) ----
# Create the tunnel in Cloudflare Zero Trust, copy the connector token here.
# CLOUDFLARED_TOKEN=

# ---- optional Cloudflare R2 media storage ----
# When all four R2_* credentials are set, uploads go to R2 instead of the
# huuk-data volume. Create a bucket-scoped R2 API token in the Cloudflare
# dashboard (R2 > Manage R2 API Tokens) and use its Access Key ID / Secret.
# R2_ACCOUNT_ID=
# R2_BUCKET=huuk-storage
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ---- optional real OAuth providers ----
# Google app sign-in + YouTube data connection share this OAuth client.
# Authorized redirect URI: https://<your-domain>/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub app sign-in (separate OAuth App from any repo integration).
# Authorization callback URL: https://<your-domain>/api/auth/oauth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
