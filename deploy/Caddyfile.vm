{
	email {$ACME_EMAIL:hontrapoowadol@gmail.com}
}

{$APP_DOMAIN:beta.huuk.teenueng.com} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self';"
		-Server
	}

	reverse_proxy {$API_UPSTREAM:app:8787} {
		flush_interval -1
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri query {
					delete code
					delete state
				}
			}
		}
	}
}
