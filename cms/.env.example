# Copy to cms/.env and fill with real secrets for non-local use.
# (Local `docker compose up` already ships DEV-ONLY defaults — this file
# is for staging/production overrides.)
#
# Generate: openssl rand -base64 32   (APP_KEYS needs 4 comma-separated values)
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me

DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=strapi_docs
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=change-me
DATABASE_SSL=false
