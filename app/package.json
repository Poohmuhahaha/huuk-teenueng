{
  "name": "content-planner-production",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "VITE_API_URL=http://127.0.0.1:8787 vite",
    "build": "vue-tsc -b && vite build",
    "build:desktop": "VITE_API_URL=http://127.0.0.1:8787 bun run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -b",
    "tauri": "tauri",
    "desktop:sidecar": "bash scripts/desktop-sidecar.sh",
    "desktop:dev": "tauri dev",
    "desktop:build": "bun run desktop:sidecar && tauri build",
    "desktop:build:local": "bun run desktop:sidecar && cargo build --release --manifest-path src-tauri/Cargo.toml --features tauri/custom-protocol"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.102.8",
    "@tanstack/vue-table": "^9.2.4",
    "motion-v": "^2.4.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.14.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
