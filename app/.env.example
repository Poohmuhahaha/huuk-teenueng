# Frontend environment (Vite). Copy to `.env.local` for local overrides.
# NOTE: every VITE_* value is baked into the built JS bundle — never put
# secrets here. Server-side secrets belong in the backend's environment.

# URL of the Rust backend. Unset in production means same-origin `/api`
# (put the frontend behind a reverse proxy that forwards /api to the server).
VITE_API_URL=http://localhost:8787

# Force the in-memory mock even in a production build (demos only).
# VITE_USE_MOCK=true

# Backend environment (for reference — set these on the server, not here):
#   PORT=8787
#   BIND_ADDR=0.0.0.0
#   DATA_FILE=data/content-planner.json   (empty string disables persistence)
#   STATIC_DIR=production/dist           (serve the built frontend from the binary)
#   DEMO_MODE=1                           (local demo: seed accounts, auth optional)
#   AUTH_REQUIRED=true                    (default when DEMO_MODE is off)
#   ALLOW_REGISTRATION=true               (default only in demo mode)
#   ADMIN_EMAIL=you@example.com           (bootstrap the first Owner account)
#   ADMIN_PASSWORD=change-me-please
#   ADMIN_TOKEN=<32+ char recovery token> (break-glass X-Admin-Token)
#   CORS_ORIGINS=https://app.example.com
#   FRONTEND_URL=https://app.example.com
#   PUBLIC_URL=https://api.example.com
#   META_APP_ID / META_APP_SECRET
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#   TIKTOK_CLIENT_KEY / TIKTOK_CLIENT_SECRET
